          "columns": [
            {
              "name": "id",
              "type": "INTEGER"
            },
            {
              "name": "language",
              "type": "TEXT"
            },
            {
              "name": "uuid",
              "type": "TEXT"
            }
          ]
        },
        {
          "name": "set_translations",
          "columns": [
            {
              "name": "id",
              "type": "INTEGER"
            },
            {
              "name": "language",

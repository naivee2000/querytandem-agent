            },
            {
              "name": "setCode",
              "type": "TEXT"
            },
            {
              "name": "translation",
              "type": "TEXT"
            }
          ]
        },
        {
          "name": "sets",
          "columns": [
            {
              "name": "code",
              "type": "TEXT"
            },
            {
              "name": "id",
              "type": "INTEGER"
            },
            {
              "name": "isOnlineOnly",
              "type": "INTEGER"
            }
          ]
        }
      ],
      "reference_result": {
        "status": "ok",
        "columns": [
          "CAST(SUM(CASE WHEN isOnlineOnly = 1 THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(id)"
        ],
        "rows_preview": [
